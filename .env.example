# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# ── Database ──────────────────────────────────────────────────────────────────
# Local Postgres from docker-compose.yml. Start it with: docker compose up -d
DATABASE_URL=postgresql://sbc:sbc_local_dev@127.0.0.1:5432/socialbychance
# Hosted instead? Paste that provider's connection string here, but change
# sslmode=require to sslmode=verify-full. `pg` treats them identically today;
# in pg v9 plain "require" drops to libpq semantics, which stops verifying the
# server's certificate. Spelling it out keeps the strong behaviour when that
# lands, and silences pg's deprecation warning now.
#   Neon      postgresql://user:pass@ep-xxx.aws.neon.tech/db?sslmode=verify-full
#   Supabase  postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres?sslmode=verify-full
#
# Connections held per server instance. Leave it alone for local work; on a
# serverless host, keep it small and point DATABASE_URL at a pooler.
# DATABASE_POOL_MAX=5

# ── UPI payee ─────────────────────────────────────────────────────────────────
# The UPI ID money lands in, e.g. socialbychance@okhdfc
UPI_VPA=
# Optional. LEAVE IT BLANK unless you know it matches your bank's verified name
# exactly — a mismatch makes UPI apps show a "payee name doesn't match" warning,
# which is the last thing you want at the moment someone is paying you.
UPI_PAYEE_NAME=

# ── Capacity ──────────────────────────────────────────────────────────────────
# Hard caps. Registration closes for a category when its cap is reached.
CAP_MALE=25
CAP_FEMALE=25

# ── Organiser ─────────────────────────────────────────────────────────────────
# Where guests reply if something goes wrong. Shown on the page.
ORGANISER_EMAIL=
# Optional, adds an Instagram link in the footer. Handle only, no @.
INSTAGRAM_HANDLE=

# ── Admin ─────────────────────────────────────────────────────────────────────
# Password for /admin. Use something long and random.
ADMIN_PASSWORD=

# ── Test prices ──────────────────────────────────────────────────────────────
# Uncomment to test a real UPI payment cheaply. Defaults are 1700 / 1200.
# PRICE_MALE=1
# PRICE_FEMALE=1

# Optional. The name the payer's UPI app will show — usually the account
# holder, not the event (e.g. "Mayank D"). Shown as a heads-up so a stranger
# is not surprised by an unfamiliar name mid-payment. Informational only:
# it is never put into the QR.
UPI_PAYEE_DISPLAY=
